# Secrets stay local and are never committed. The evaluator command works with none of these.
# Every key below is optional; the same command uses whichever are present.
# Search (website candidates only; every candidate must pass exact-company proof)
SERPAPI_API_KEY=
SERPAPI_API_KEY_2=
TAVILY_API_KEY=
# Models (choose an index or the next tool; never write facts)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint, https only
# OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Budgets and switches
# ORGLENS_KEYS=auto                       # off = ignore every key
# ORGLENS_SEARCH_QUERIES_PER_COMPANY=3
# ORGLENS_MODEL_CALLS_PER_COMPANY=3
# ORGLENS_MAX_SEARCH_QUERIES=
# ORGLENS_MAX_MODEL_CALLS=
# ORGLENS_MODEL_PROVIDERS=openai,anthropic,gemini,groq,nvidia,cloudflare,cohere,mistral
# Optional: NAV job-feed consumer token. Without it the published public token is used.
NAV_FEED_TOKEN=
