# Secrets stay local. Existing NVDIA_API_KEY, Cloudflare_API_KEY and AccountID
# aliases are accepted by scripts/verify_providers.py.
GROQ_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Optional search provider; leave pay-as-you-go disabled in its dashboard.
TAVILY_API_KEY=
SERPAPI_API_KEY=
# Optional: NAV job-feed consumer token. Without it the published public token is used.
NAV_FEED_TOKEN=
